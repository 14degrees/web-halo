{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "halo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../build/cloudflare-web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // the game page carries the X Player Card tags (src/embed.js)
    "run_worker_first": ["/", "/embed", "/embed/"]
  },
  "routes": [
    { "pattern": "halois.fun", "custom_domain": true }
  ],
  "vars": {
    // the card's attribution; leave empty for none
    "TWITTER_SITE": "@onchainqt",
    // origins allowed to frame /embed besides X (space-separated), for testing
    "EMBED_FRAME_ANCESTORS": ""
  },
  "analytics_engine_datasets": [
    {
      "binding": "PERFORMANCE_TELEMETRY",
      "dataset": "halo_web_performance"
    },
    {
      "binding": "CAMPAIGN_TELEMETRY",
      "dataset": "halo_web_campaign_loads"
    },
    {
      "binding": "RUNTIME_TELEMETRY",
      "dataset": "halo_web_runtime"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
