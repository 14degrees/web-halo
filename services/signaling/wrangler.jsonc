{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "halo-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Safe-by-default deployment settings. The exact public game origin is
    // allowed alongside the two deterministic local-development origins.
    "ENVIRONMENT": "production",
    // The game server pool's Fly app, which the matchmaker scales (its
    // FLY_API_TOKEN is a secret; services/game-server/fly/pool.py).
    "FLY_APP_NAME": "halo-game-lilchocobo",
    // the page's ping to the game before a match: one probe URL per region
    // (the gateway's GET /ping, exposed over HTTPS in services/game-server/fly/fly.toml)
    "PING_TARGETS": "[{\"id\":\"lax\",\"label\":\"Los Angeles\",\"url\":\"https://halo-game-lilchocobo.fly.dev/ping\"}]",
    "ALLOWED_ORIGINS": "https://halo.lilchocobo2.workers.dev,http://127.0.0.1:8765,http://localhost:8765",
    "ALLOW_NO_ORIGIN": "false",
    "PUBLIC_GAME_URL": "https://halo.lilchocobo2.workers.dev",
    "ROOM_TTL_SECONDS": "21600",
    "SESSION_TTL_SECONDS": "30",
    "TURN_TTL_SECONDS": "3600",
    "TURNSTILE_HOSTNAMES": "",
    "CLOUDFLARE_ACCOUNT_ID": "86f73ff8d0ff09a24168f22d41b88b8b",
    "TURN_ACTOR_HOURLY_EGRESS_CAP_BYTES": "1000000000",
    "TURN_GLOBAL_DAILY_EGRESS_CAP_BYTES": "10000000000",
    "DEFAULT_ROOM_CAPACITY": "128",
    "MAX_ROOM_CAPACITY": "128",
    // Rooms a dedicated host creates live this long between renewals.
    "DEDICATED_ROOM_TTL_SECONDS": "86400",
    // The game quick join starts when no public room is open:
    // Blood Gulch (9) Slayer (0); see port/web/src/web_online_ui.h.
    "PUBLIC_LOBBY_MAP_INDEX": "9",
    "PUBLIC_LOBBY_MODE_INDEX": "0",
    // Wallets and the escrow program's cluster.
    "SOLANA_CLUSTER": "devnet",
    // Tried in order: Solana's own devnet endpoint refuses Cloudflare.
    "SOLANA_RPC_URL": "https://api.devnet.solana.com,https://solana-devnet.api.onfinality.io/public",
    // The escrow program (services/escrow) on SOLANA_CLUSTER: where its fee
    // goes and the fee's rate (it may not exceed the program's own setting).
    // Its authority key and session secret are secrets.
    "ESCROW_FEE_VAULT": "8fLfv5vkEkUDvDuwHx6PpZPiF7A5ALNB7AhFxRtA6aAM",
    "ESCROW_FEE_BPS": "500",
    // fomo.family detection (src/fomo.ts): the mainnet wallet fomo pays its
    // users' fees from. The mainnet RPC URL is the FOMO_RPC_URL secret.
    "FOMO_FEE_PAYER": "AgmLJBMDCqWynYnQiPCuj9ewsNNsBJXyzoUhD9LJzN51",
    // The page's links out (src/site.ts): the fomo referral code behind
    // the landing's fomo.family link, and the game's X profile URL (none
    // chosen yet: the link stays hidden until this is set).
    "FOMO_REFERRAL_CODE": "ARCH",
    "X_PROFILE_URL": ""
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "BROADCASTS",
      "bucket_name": "halo-broadcasts"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HALO_ABUSE",
      "id": "0360e1b80a7f43a095ecdbd714e9934d"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "TURN_EVENTS",
      "dataset": "halo_turn_events"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "SignalingRoom"
      },
      {
        "name": "LOBBY_DIRECTORY",
        "class_name": "LobbyDirectory"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      },
      {
        "name": "WAGERS",
        "class_name": "Wager"
      },
      {
        "name": "PARTIES",
        "class_name": "Party"
      },
      {
        "name": "PROFILES",
        "class_name": "Profiles"
      },
      {
        "name": "STATS",
        "class_name": "Stats"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "SESSION_CREATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 512,
        "period": 60
      }
    },
    {
      "name": "TURN_ISSUE_LIMITER",
      "namespace_id": "41003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      // username claims and renames (src/profile.ts); the store also caps
      // renames per profile per day
      "name": "PROFILE_CLAIM_LIMITER",
      "namespace_id": "41004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LobbyDirectory"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Bank"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["Matchmaker"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["Wager"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["Party"]
    },
    {
      // the house ledger, replaced by the escrow program's vaults
      "tag": "v7",
      "deleted_classes": ["Bank"]
    },
    {
      // players' profiles: usernames, wallets, fomo and X links
      "tag": "v8",
      "new_sqlite_classes": ["Profiles"]
    },
    {
      // players' lasting stats and the leaderboard
      "tag": "v9",
      "new_sqlite_classes": ["Stats"]
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
